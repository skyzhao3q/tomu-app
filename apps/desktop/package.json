{
  "name": "@tomu/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "tsx watch src/main/index.ts",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no lint configured yet'",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "node scripts/dev.mjs",
    "electron:build": "electron-builder"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.50",
    "@ai-sdk/google": "^3.0.34",
    "@ai-sdk/openai": "^3.0.37",
    "@tomu/core": "workspace:*",
    "ai": "^6.0.105",
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.44.4",
    "express": "^5.1.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "zod": "^3.25.23"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "vitest": "^3.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.tomu.desktop",
    "productName": "tomu",
    "mac": {
      "category": "public.app-category.productivity"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../viewer/dist",
        "to": "viewer/dist"
      }
    ]
  }
}
